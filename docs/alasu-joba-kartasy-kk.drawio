<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" compressed="false" type="device">
  <diagram id="alasu-kk-map" name="Alasu жобасының картасы">
    <mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2320" pageHeight="7928" background="#F6F8FC">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="branch-01-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#bdcfe6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Бір тапсырыстың толық жолы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Дүкенге барудан бастап тауарды жеткізуге, ақшаны салыстыруға және 1С-ке енгізуге дейінгі жұмысты байланыстырады.&lt;/span&gt;">
          <mxGeometry x="1430" y="70" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#bdcfe6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Бірізді деректер&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тапсырыс, қойма, рейс, төлем және құжат бір жүйеде тіркеледі. Әр қызметкер өзіне тиесілі жұмысты көреді.&lt;/span&gt;">
          <mxGeometry x="1430" y="176" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e2eaf4;strokeColor=#9cb7d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Жобаның мақсаты&lt;/span&gt;">
          <mxGeometry x="912" y="140" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#bdcfe6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;1 веб-сайт&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Компьютерден де, телефон браузерінен де ашылады. Вебте 8 мәзір бөлімі және 59 кіру нүктесі бар.&lt;/span&gt;">
          <mxGeometry x="1430" y="298" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#bdcfe6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;1 мобильді қосымша&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Далалық жұмыс, жеткізу және қойма режимдері бар. Телефон режимі 8 лауазымға бапталған. Қосымша сынақ кезеңінде.&lt;/span&gt;">
          <mxGeometry x="1430" y="404" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e2eaf4;strokeColor=#9cb7d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Екі жұмыс ортасы&lt;/span&gt;">
          <mxGeometry x="912" y="368" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#bdcfe6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;1С бухгалтериясы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Бухгалтерлік есеп бөлек 1С жүйесінде жүргізіледі. Alasu құжаттар пакетін дайындайды, уәкілетті қызметкер оны 1С-ке қолмен жүктейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="526" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-01-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e2eaf4;strokeColor=#9cb7d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Жүйенің шекарасы&lt;/span&gt;">
          <mxGeometry x="912" y="543" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-01" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#316AB0;strokeColor=#316AB0;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;01&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Жоба және платформалар&lt;/span&gt;">
          <mxGeometry x="466" y="297" width="324" height="94" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Құрылтайшы және бас директор&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Компания бойынша қорытынды көрсеткіштерді, шешім күтетін мәселелерді және жеткізу барысын қарайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="698" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Өңірлік және коммерциялық директор&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Өңір, сату және коммерциялық көрсеткіштерді берілген рұқсаттар аясында бақылайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="804" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Басшылық · 4&lt;/span&gt;">
          <mxGeometry x="912" y="760" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Сату тобының басшылары&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Сату жетекшісі, супервайзер және аумақтық менеджер команданы басқарады.&lt;/span&gt;">
          <mxGeometry x="1430" y="911" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Тапсырыс пен талдау&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Сауда өкілі, тапсырыс операторы және сату талдаушысы өз міндетіне сай тапсырыспен немесе есеппен жұмыс істейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="1002" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-2-leaf-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Дүкендегі тауар жаймасы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Мерчендайзер және тұрақты мерчендайзер сөрені тексеріп, фото мен тексеру парағын тіркейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="1108" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Сату · 8&lt;/span&gt;">
          <mxGeometry x="912" y="1019" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Басқару және талдау&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Қаржы директоры мен қаржы талдаушысы касса, берешек, шығыс және есеп көрсеткіштерін қарайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="1215" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-3-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Бухгалтерия және касса&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Бас бухгалтер, бухгалтер көмекшісі және кассир төлемді, кассалық құжатты немесе 1С пакетін өз рұқсатына сай өңдейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="1321" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Қаржы · 5&lt;/span&gt;">
          <mxGeometry x="912" y="1285" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-4-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Қойма операциялары&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Қоймашы, қойма меңгерушісі және қойма логисі жинақтау, қабылдау, қалдық пен түгендеуді рұқсатына сай жүргізеді.&lt;/span&gt;">
          <mxGeometry x="1430" y="1443" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-4-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жинақтау және тиеу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тауар жинаушы мен жүк тиегіш жүргізушісінің қойма деректеріне қолжетімділігі міндетіне қарай беріледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="1549" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-4" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Қойма · 5&lt;/span&gt;">
          <mxGeometry x="912" y="1513" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-5-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Маршрут пен көлік&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Жеткізу логисі рейс құрады. Экспедитор мен аға экспедитор өз рейсін орындайды. Жүк көлігі жүргізушісінің рөлі бөлек.&lt;/span&gt;">
          <mxGeometry x="1430" y="1671" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-5" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Жеткізу · 4&lt;/span&gt;">
          <mxGeometry x="912" y="1688" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-6-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Әкімшілік пен мамандар&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;HR әкімшісі, жүйе әкімшісі, тоңазытқыш жабдықтары бойынша логист, заңгер, қауіпсіздік қызметкері және маркетинг маманы.&lt;/span&gt;">
          <mxGeometry x="1430" y="1793" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-6" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Қолдау · 6&lt;/span&gt;">
          <mxGeometry x="912" y="1810" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-7-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cfc4e2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;32 рөл · 8 жұмыс беті&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;12 рөлге бастапқы бет арнайы бапталған. Қалған 20 рөл жүйеге кіргенде өзі аша алатын алғашқы бетке өтеді.&lt;/span&gt;">
          <mxGeometry x="1430" y="1915" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-02-group-7" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#eae5f2;strokeColor=#b7a7d4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Жұмыс бетіне кіру&lt;/span&gt;">
          <mxGeometry x="912" y="1932" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-02" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#6948A5;strokeColor=#6948A5;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;02&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Лауазымдар мен рұқсаттар&lt;/span&gt;">
          <mxGeometry x="466" y="1306" width="324" height="94" as="geometry" />
        </mxCell>
        <mxCell id="branch-03-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#bed1dc;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Басты бет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Құрылтайшының бақылау тақтасы, «Менің күнім» және тапсырмалар.&lt;/span&gt;">
          <mxGeometry x="1430" y="2087" width="790" height="77" as="geometry" />
        </mxCell>
