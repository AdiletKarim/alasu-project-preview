        <mxCell id="branch-04-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Дүкенге бару&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Сауда өкілі мен мерчендайзерлер маршрутты қарап, барғанын белгілейді, фото түсіреді және тексеру парағын толтырады.&lt;/span&gt;">
          <mxGeometry x="1430" y="2944" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Сауда өкілінің жұмысы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Жаңа сауда нүктесін тіркейді, тапсырыс жасайды, оның күйін және клиент берешегін қарайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="3050" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#ddedec;strokeColor=#8bc3be;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Далалық жұмыс · 3 рөл&lt;/span&gt;">
          <mxGeometry x="912" y="3006" width="383" height="58" as="geometry" />
