        <mxCell id="branch-03" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#336F91;strokeColor=#336F91;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;03&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Веб-сайттың бөлімдері&lt;/span&gt;">
