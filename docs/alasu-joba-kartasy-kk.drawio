        </mxCell>
        <mxCell id="branch-04-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#ddedec;strokeColor=#8bc3be;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Қойма · 3 рөл&lt;/span&gt;">
          <mxGeometry x="912" y="3455" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-4-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Аккаунт пен тіл&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Құрылғыны белсендіру, профиль, құпиясөз, қазақша және орысша интерфейс, тапсырмалар мен қолданба ішіндегі хабарламалар.&lt;/span&gt;">
          <mxGeometry x="1430" y="3613" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-4-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Байланыс үзілгенде&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Офлайн қолдауы бар әрекеттер телефонда сақталады. Байланыс келгенде жіберіледі, ал қабылданбаған жазбаның себебі көрсетіледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="3719" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-4" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#ddedec;strokeColor=#8bc3be;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Барлық режимге ортақ&lt;/span&gt;">
          <mxGeometry x="912" y="3683" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-04" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#0D8177;strokeColor=#0D8177;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;04&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Мобильді қосымша&lt;/span&gt;">
          <mxGeometry x="466" y="3330" width="324" height="94" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Кіруді тіркеу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Сауда өкілі жұмыс күнін бастайды, сауда нүктесінде тұрғанын GPS арқылы растайды, фото мен тексеру парағын сақтайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="3891" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жабдықты тексеру&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тоңазытқыш немесе витрина кодын сканерлеп, оның осы нүктеде тіркелгенін тексереді. Фото сол сапардағы күйін көрсетеді, орнату тарихы бөлек сақталады.&lt;/span&gt;">
          <mxGeometry x="1430" y="3997" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;1 · Дүкенге бару&lt;/span&gt;">
          <mxGeometry x="912" y="3961" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Клиентті таңдау&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Бар клиентті ашу немесе жаңа нүктенің атауын, мекенжайын, орнын және байланысын енгізіп, қайталануын тексеру.&lt;/span&gt;">
          <mxGeometry x="1430" y="4119" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жүйелік тексеріс&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Баға, берешек шегі және шектеулер тексеріледі. Шарттан өткен тапсырыс бірден «Жеткізуге дайын тапсырыстар» тізіміне түседі.&lt;/span&gt;">
          <mxGeometry x="1430" y="4225" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;2 · Тапсырыс&lt;/span&gt;">
          <mxGeometry x="912" y="4189" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Логист · веб&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тапсырыстарды іріктейді, көлік пен экспедиторды бекітеді, аялдамалар ретін қояды. Жүйе тиеу тізімін жасайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="4347" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;3 · Рейс құру&lt;/span&gt;">
          <mxGeometry x="912" y="4364" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-4-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Қоймашы · қосымша&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тиеу тізімімен тауарды жинайды. Нақты санын және жетіспеу себебін енгізеді, «Берілді» деп белгілейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="4469" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-4-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Экспедитор · қосымша&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Берілген тауарды қайта санайды. Қабылдағаннан кейін қойма қалдығы азаяды және жүкқұжат нөмірі беріледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="4575" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-4" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;4 · Тауарды беру&lt;/span&gt;">
          <mxGeometry x="912" y="4539" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-5-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жеткізу нәтижесі&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Толық не ішінара жеткізу, клиенттің бас тартуы немесе жеткізе алмау тіркеледі. Қажет болса қол қойылған жүкқұжат суретке түсіріледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="4697" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-5-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Төлемді тіркеу&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Қолма-қол, аударым және Kaspi QR сомалары бөлек жазылады. Аударым не QR үшін чек фотосын қосуға болады.&lt;/span&gt;">
          <mxGeometry x="1430" y="4803" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-5" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;5 · Дүкенге жеткізу&lt;/span&gt;">
          <mxGeometry x="912" y="4767" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-6-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Касса мен қойма&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Кассир нақты қолма-қол ақшаны қабылдайды. Қоймашы қайтқан тауарды санап, жарамдысы мен ақаулысын бөлек тіркейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="4925" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-6" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;6 · Ақша мен қайтарымды өткізу&lt;/span&gt;">
          <mxGeometry x="912" y="4942" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-7-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e3c4d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Бухгалтер · веб және 1С&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Дайын құжаттар пакетін экспорттайды. Уәкілетті қызметкер оны 1С-ке жүктейді, нәтижені және 1С құжат нөмірін Alasu-да белгілейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="5047" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-05-group-7" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e5ee;strokeColor=#d6a7c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;7 · 1С-ке енгізу&lt;/span&gt;">
          <mxGeometry x="912" y="5064" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-05" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#A94788;strokeColor=#A94788;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;05&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Тапсырыстан 1С-ке дейін&lt;/span&gt;">
          <mxGeometry x="466" y="4468" width="324" height="94" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Қолма-қол ақша&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Экспедитор өткізген соманы кассир растайды. Кіріс кассалық ордері жасалады, оны тиісті рұқсаты бар екінші адам бекітеді.&lt;/span&gt;">
          <mxGeometry x="1430" y="5219" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Аударым және Kaspi QR&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Бухгалтер төлемді банк немесе Kaspi көшірмесімен салыстырады. 1С-тегі ақшалай кіріс банк көшірмесі бойынша тіркеледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="5325" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e7e0;strokeColor=#d7ae93;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Төлемді салыстыру&lt;/span&gt;">
          <mxGeometry x="912" y="5289" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Ортақ тексеру тізбегі&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тапсырыс → рейс → жүкқұжат → төлем немесе қайтарым → 1С құжаты. Тауар саны мен соманы осы нөмірлер арқылы салыстырады.&lt;/span&gt;">
          <mxGeometry x="1430" y="5447" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Сәйкессіздік және түзету&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Экспедитор қате нәтижені түзетуді сұрай алады. Рұқсаты бар басқа қызметкер түзетуді тексереді.&lt;/span&gt;">
          <mxGeometry x="1430" y="5553" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e7e0;strokeColor=#d7ae93;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Құжаттардың байланысы&lt;/span&gt;">
          <mxGeometry x="912" y="5517" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Кіріс деректері&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;1С-тен алынған деректер тауар қалдығын, өткізуді, төлемді және берешекті салыстыруға пайдаланылады.&lt;/span&gt;">
          <mxGeometry x="1430" y="5675" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-3-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Шығыс құжаттары&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Пакетке жарамды құжаттар кіреді. Жүктелмеген немесе түзетуді қажет ететін құжаттың себебі көрсетіледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="5781" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-3-leaf-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#e4c9b7;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Бөлек сақталатын дәлел&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Қабылдау, қол қойылған жүкқұжат және төлем чегінің суретін Alasu-дан қарауға болады. 1С пакеті құжат деректерін тасымалдайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="5887" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-06-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#f3e7e0;strokeColor=#d7ae93;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;1С-пен дерек алмасу&lt;/span&gt;">
          <mxGeometry x="912" y="5798" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-06" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#AC561E;strokeColor=#AC561E;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;06&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Ақша, құжаттар және 1С&lt;/span&gt;">
          <mxGeometry x="466" y="5552" width="324" height="94" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Веб-интерфейс&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;React қолданбасы. Бет, мәзір және әрекеттер ағымдағы аккаунттың рұқсатына қарай ашылады.&lt;/span&gt;">
          <mxGeometry x="1430" y="6059" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Мобильді интерфейс&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;React Native және Expo. SQLite кэші мен жіберу кезегі офлайн жұмысқа көмектеседі.&lt;/span&gt;">
          <mxGeometry x="1430" y="6150" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e4ebee;strokeColor=#a1b9c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Клиенттік бөлік&lt;/span&gt;">
          <mxGeometry x="912" y="6114" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;API және бизнес логика&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;FastAPI тапсырыс, қойма, жеткізу, төлем және 1С алмасу модульдерін байланыстырады.&lt;/span&gt;">
          <mxGeometry x="1430" y="6257" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Деректер мен файлдар&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;PostgreSQL және PostGIS негізгі деректер мен координаттарды сақтайды. Фотолар файл қоймасында сақталады.&lt;/span&gt;">
          <mxGeometry x="1430" y="6348" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-2-leaf-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Фондық жұмыс&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Celery және Redis жоспарлы есеп, бақылау және фондық тапсырмаларды жүргізеді.&lt;/span&gt;">
          <mxGeometry x="1430" y="6454" width="790" height="77" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e4ebee;strokeColor=#a1b9c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Сервер және сақтау&lt;/span&gt;">
          <mxGeometry x="912" y="6365" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Рөл мен әрекет&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Бір рөл мәзірді көруі, екіншісі сол бетте деректі өңдеуі мүмкін. Мысалы, бас директор жеткізу тізімін көреді, логист рейс құра алады.&lt;/span&gt;">
          <mxGeometry x="1430" y="6561" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-3-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#c1d1d9;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Дерек ауқымы мен журнал&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Сервер рұқсат пен дерек ауқымын тексереді. Маңызды әрекет журналға жазылады, ал кейбір операцияны екінші адам растайды.&lt;/span&gt;">
          <mxGeometry x="1430" y="6667" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-07-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e4ebee;strokeColor=#a1b9c6;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Рұқсат және бақылау&lt;/span&gt;">
          <mxGeometry x="912" y="6631" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-07" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#3C6E88;strokeColor=#3C6E88;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;07&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Техникалық архитектура&lt;/span&gt;">
          <mxGeometry x="466" y="6362" width="324" height="94" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-1-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Сынақ кезеңі&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Қосымша барлық қызметкердің телефонына таратылған жоқ. Қоймадан 1С пакетін жасауға дейінгі негізгі сценарий автоматты түрде тексерілген.&lt;/span&gt;">
          <mxGeometry x="1430" y="6839" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-1-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Тексеру нәтижесі&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Іріктелген 349 автоматты тест сәтті өтті: серверде 172, вебте 67 және қосымшада 110. Нақты телефон және сынақ 1С базасына импорт бөлек тексеріледі.&lt;/span&gt;">
          <mxGeometry x="1430" y="6945" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e8ece4;strokeColor=#afbda4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Қазіргі жағдай&lt;/span&gt;">
          <mxGeometry x="912" y="6909" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жауапты: __________&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Бір тапсырысты телефоннан өткізу. GPS, фото, үзіліп-қайта қосылған байланыс және деректің серверге жетуін бақылау.&lt;/span&gt;">
          <mxGeometry x="1430" y="7067" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Құжатпен растау&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тапсырыс, тиеу тізімі, жүкқұжат және 1С құжатының нөмірлерін жазып, тауар саны мен төлемді салыстыру.&lt;/span&gt;">
          <mxGeometry x="1430" y="7173" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e8ece4;strokeColor=#afbda4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;1-адам · процесті сынау&lt;/span&gt;">
          <mxGeometry x="912" y="7137" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жауапты: __________&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Ортақ телефондағы тапсырыс кэшін қызметкер бойынша оқшаулау. Аккаунт өзгергенде бұрынғы адамның тапсырыстары көрінбеуі керек.&lt;/span&gt;">
          <mxGeometry x="1430" y="7295" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-3-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;1С экспорты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Төлем түсіндірмесінде тиынға дейінгі дәлдікті сақтау. Мысалы, 1 234,51 ₸ сомасы бүтін санға айналмауы керек.&lt;/span&gt;">
          <mxGeometry x="1430" y="7401" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-3-leaf-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Windows сынақ ортасы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Дерекқорды жаңарту конфигурациясының кодталуын түзетіп, негізгі тармақтағы миграцияны қайта тексеру.&lt;/span&gt;">
          <mxGeometry x="1430" y="7507" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-3" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e8ece4;strokeColor=#afbda4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;2-адам · ақауды түзету&lt;/span&gt;">
          <mxGeometry x="912" y="7418" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-4-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Жұмыс жазбасы&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Әр тармақта жауапты адамды, күйді және дәлелді белгілеу: «Кезекте», «Жұмыста», «Тексерілді».&lt;/span&gt;">
          <mxGeometry x="1430" y="7629" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-4-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#cad3c2;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Өту шарты&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Тауар саны сәйкес, ақша салыстырылған, құжат нөмірлері табылған және сынақ 1С базасында импорт нәтижесі жазылған.&lt;/span&gt;">
          <mxGeometry x="1430" y="7735" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-08-group-4" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#e8ece4;strokeColor=#afbda4;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Бірге қабылдау&lt;/span&gt;">
          <mxGeometry x="912" y="7699" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-08" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#FFFFFF;fillColor=#587641;strokeColor=#587641;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:12px;color:#FFFFFF;font-weight:600&quot;&gt;08&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px;color:#FFFFFF;font-weight:700&quot;&gt;Сынақ және бірлескен жұмыс&lt;/span&gt;">
