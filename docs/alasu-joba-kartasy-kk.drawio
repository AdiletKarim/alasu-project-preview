        <mxCell id="branch-04-group-2-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Рейс және дүкендер&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Экспедитор мен аға экспедитор тауарды қабылдап, дүкенге дейін бағыт алады және жеткізу нәтижесі мен төлемді тіркейді.&lt;/span&gt;">
          <mxGeometry x="1430" y="3157" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-2-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Құжат пен қайтарым&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Жүкқұжатты көрсетеді, қол қойылған құжатты суретке түсіреді, жеткізілмеген тауарды тіркейді және түзету сұрай алады.&lt;/span&gt;">
          <mxGeometry x="1430" y="3263" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#ddedec;strokeColor=#8bc3be;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:19px;color:#172B45;font-weight:700&quot;&gt;Жеткізу · 2 рөл&lt;/span&gt;">
          <mxGeometry x="912" y="3227" width="383" height="58" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-3-leaf-1" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Тауарды жинақтау&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Қоймашы, қойма меңгерушісі және қойма логисі өз рұқсатына сай тиеу тізімін ашып, тауарды жинап береді.&lt;/span&gt;">
          <mxGeometry x="1430" y="3385" width="790" height="92" as="geometry" />
        </mxCell>
        <mxCell id="branch-04-group-3-leaf-2" parent="1" vertex="1" style="rounded=1;arcSize=17;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=16;fontFamily=Segoe UI;fontColor=#172B45;fillColor=#FFFFFF;strokeColor=#b2d7d3;strokeWidth=1.3;" value="&lt;span style=&quot;font-size:18px;color:#172B45;font-weight:700&quot;&gt;Қабылдау және қалдық&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#4C5F79&quot;&gt;Келген және рейстен қайтқан тауарды қабылдайды, қалдық пен партияны қарайды. Түгендеу рұқсат болғанда ашылады.&lt;/span&gt;">
